{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "split-headline",
  "type": "hyperframes:component",
  "title": "Split Headline",
  "description": "A headline that rises out of masks word by word, character by character or line by line (GSAP SplitText), with a kicker and an accent rule. Mount: <div id=\"split-headline-1\" class=\"clip\" data-composition-id=\"split-headline\" data-composition-src=\"compositions/components/split-headline.html\" data-start=\"0\" data-duration=\"3.5\" data-track-index=\"0\"></div>, with data-variable-values to set the variables.",
  "tags": [
    "text",
    "headline",
    "reveal",
    "split-text",
    "gsap-plugin"
  ],
  "author": "Glintmotion",
  "license": "PolyForm-Noncommercial-1.0.0",
  "files": [
    {
      "path": "split-headline.html",
      "target": "compositions/components/split-headline.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "The headline.",
      "default": "Every frame, on purpose."
    },
    {
      "id": "kicker",
      "type": "string",
      "role": "content",
      "label": "Kicker",
      "description": "Small label above the headline. Empty hides it.",
      "default": "GLINTMOTION"
    },
    {
      "id": "split",
      "type": "enum",
      "role": "style",
      "label": "Split",
      "description": "Unit that rises out of its mask.",
      "default": "words",
      "options": [
        {
          "value": "words",
          "label": "Words"
        },
        {
          "value": "chars",
          "label": "Characters"
        },
        {
          "value": "lines",
          "label": "Lines"
        }
      ]
    },
    {
      "id": "align",
      "type": "enum",
      "role": "style",
      "label": "Align",
      "description": "Text alignment.",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "id": "exit",
      "type": "enum",
      "role": "timing",
      "label": "Exit",
      "description": "none holds until the cut.",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
